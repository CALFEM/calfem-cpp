{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_FEATURES": "tests;mesh",
        "CALFEM_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs",
      "displayName": "Visual Studio solution",
      "description": "Multi-config Visual Studio solution (build-vs/calfem.slnx)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "qt",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-qt",
        "VCPKG_MANIFEST_FEATURES": "tests;mesh;qt",
        "CALFEM_WITH_QT": "ON"
      }
    },
    {
      "name": "debug-qt",
      "displayName": "Debug with Qt",
      "inherits": [ "qt", "debug" ]
    },
    {
      "name": "release-qt",
      "displayName": "Release with Qt",
      "inherits": [ "qt", "release" ]
    },
    {
      "name": "vs-qt",
      "displayName": "Visual Studio solution with Qt",
      "description": "Multi-config Visual Studio solution with Qt (build-vs-qt/calfem.slnx)",
      "inherits": [ "qt", "vs" ]
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "vs-debug", "configurePreset": "vs", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "debug-qt", "configurePreset": "debug-qt" },
    { "name": "release-qt", "configurePreset": "release-qt" },
    { "name": "vs-qt-debug", "configurePreset": "vs-qt", "configuration": "Debug" },
    { "name": "vs-qt-release", "configurePreset": "vs-qt", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs-debug",
      "configurePreset": "vs",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs-release",
      "configurePreset": "vs",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-qt",
      "configurePreset": "debug-qt",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-qt",
      "configurePreset": "release-qt",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs-qt-debug",
      "configurePreset": "vs-qt",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs-qt-release",
      "configurePreset": "vs-qt",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
